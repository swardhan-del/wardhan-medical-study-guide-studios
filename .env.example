# Optional: final public origin. Leave unset for Vercel's generated domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public creator identity and contact email are maintained in src/content/studio.ts.

# Do NOT set LOCAL_CURATION_REVIEW on Vercel. npm run review sets it locally.

# Optional: Search Console HTML-tag verification token (URL-prefix property).
# GOOGLE_SITE_VERIFICATION=

# Separate synthetic pilot only. Set exclusively on the pilot branch in Vercel Preview.
# Never set these in Production. Leave unset to keep member access closed.
# MEMBERSHIP_PILOT_ENABLED=
# MEMBERSHIP_PILOT_ORIGIN=
# MEMBERSHIP_PILOT_EMAIL_ALLOWLIST=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Local admin only: explicit preview project ref confirmation, never a Vercel variable.
# PILOT_ADMIN_PROJECT_REF=
