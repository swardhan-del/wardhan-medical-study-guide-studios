# Optional: final public origin. Leave unset for Vercel's generated domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Public creator identity and contact email are maintained in src/content/studio.ts.

# Do NOT set LOCAL_CURATION_REVIEW on Vercel. npm run review sets it locally.

# Optional: Search Console HTML-tag verification token (URL-prefix property).
# GOOGLE_SITE_VERIFICATION=

# Optional measurement: disabled unless all HTTP integration settings are valid.
# Hosted Vercel previews and local private review always disable collection.
# These are server-only settings. Never prefix credentials with NEXT_PUBLIC_.
MEASUREMENT_PROVIDER=off
# MEASUREMENT_PROVIDER=http
# MEASUREMENT_ENDPOINT=https://your-approved-collector.example/events
# MEASUREMENT_TOKEN=server-only-bearer-token
# MEASUREMENT_RECIPIENT_NAME=Your approved analytics recipient
# MEASUREMENT_PRIVACY_URL=https://your-approved-collector.example/privacy
# Bump this when changing measurement purposes or the recipient policy.
# MEASUREMENT_POLICY_VERSION=1
# Waitlist defaults to a browser-only demo. Vercel previews always stay in demo.
# Set these SERVER variables only after completing docs/WAITLIST_FOUNDATION.md.
# WAITLIST_MODE=demo
# Live option: WAITLIST_MODE=brevo (incomplete config fails closed)
# WAITLIST_ORIGIN=https://your-domain.example
# BREVO_API_KEY=
# BREVO_WAITLIST_LIST_ID=
# BREVO_DOI_TEMPLATE_ID=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
